@page "/processes"
@using IIGO.Services
@using System.Diagnostics
@using System.Management
@using System.Dynamic
@using System.Security.Principal;
@using System.Text;
@using Windows.Win32
@using System.Runtime.InteropServices
@using Microsoft.Win32.SafeHandles
@using System.Threading.Tasks
@attribute [Authorize(Policy = Feature.ViewSystemStatus)]
@rendermode InteractiveServer

<PageTitle>Processes</PageTitle>

<h1>Processes</h1>

@if (processes == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>PID</th>
                <th>Name</th>
                <th>User</th>
                <th>Memory Usage</th>
                <th>CPU %</th>
                <th>Command Line</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var proc in processes)
            {
                <tr>
                    <td>@proc.Id</td>
                    <td>@proc.ProcessName</td>
                    <td>@GetProcessUser(proc)</td>
                    <td>@((proc.WorkingSet64 / 1024).ToString("N0")) KB</td>
                    <td>
                        @{
                            if (cpuUsages.TryGetValue(proc.Id, out var cpu))
                            {
                                <text>@($"{cpu:F1} %")</text>;
                            }
                            else
                            {
                                <text>—</text>;
                            }
                        }
                    </td>
                    <td style="max-width:400px;text-overflow: ellipsis;white-space: nowrap;overflow:hidden">@GetCommandLineOfProcess(proc)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    Process[]? processes;

    // computed CPU usage per PID
    readonly Dictionary<int, double> cpuUsages = new();

    // how long to measure CPU time before showing the snapshot
    static readonly TimeSpan sampleInterval = TimeSpan.FromSeconds(1);

    // sample only after the interactive render so prerendering isn't delayed
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var firstSample = SampleProcessorTimes(GetProcesses());
        var startTime = DateTime.UtcNow;

        await Task.Delay(sampleInterval);

        var currentProcs = GetProcesses();
        var secondSample = SampleProcessorTimes(currentProcs);
        var intervalMs = (DateTime.UtcNow - startTime).TotalMilliseconds;

        foreach (var (pid, currentTotal) in secondSample)
        {
            if (firstSample.TryGetValue(pid, out var prevTotal))
            {
                // CPU% = (deltaTotalTime / interval) / logicalProcessorCount * 100
                var deltaMs = (currentTotal - prevTotal).TotalMilliseconds;
                cpuUsages[pid] = Math.Max(0.0, deltaMs / (intervalMs * Environment.ProcessorCount) * 100.0);
            }
        }

        // highest CPU first; processes without a reading go last, then by memory
        processes = currentProcs
            .OrderByDescending(x => cpuUsages.TryGetValue(x.Id, out var cpu) ? cpu : -1.0)
            .ThenByDescending(x => x.WorkingSet64)
            .ToArray();
        StateHasChanged();
    }

    private static Process[] GetProcesses()
    {
        return Process.GetProcesses().Where(x => x.ProcessName != "Memory Compression").OrderByDescending(x => x.WorkingSet64).ToArray();
    }

    private static Dictionary<int, TimeSpan> SampleProcessorTimes(Process[] procs)
    {
        var times = new Dictionary<int, TimeSpan>();
        foreach (var p in procs)
        {
            try
            {
                times[p.Id] = p.TotalProcessorTime;
            }
            catch
            {
                // ignore processes we can't access
            }
        }
        return times;
    }

    private static string? GetProcessUser(Process process)
    {
        IntPtr processHandle = IntPtr.Zero;
        try
        {
            OpenProcessToken(process.Handle, 8, out processHandle);
            WindowsIdentity wi = new WindowsIdentity(processHandle);
            string user = wi.Name;
            return user.Contains(@"\") ? user.Substring(user.IndexOf(@"\") + 1) : user;
        }
        catch
        {
            return null;
        }
        finally
        {
            if (processHandle != IntPtr.Zero)
            {
                CloseHandle(processHandle);
            }
        }
    }

    string GetCommandLineOfProcess(Process proc)
    {
        ProcessCommandLine.Retrieve(proc, out var cl);
        return cl;
    }

    [DllImport("advapi32.dll", SetLastError = true)]
    private static extern bool OpenProcessToken(IntPtr ProcessHandle, uint DesiredAccess, out IntPtr TokenHandle);
    [DllImport("kernel32.dll", SetLastError = true)]
    [return: MarshalAs(UnmanagedType.Bool)]
    private static extern bool CloseHandle(IntPtr hObject);

}
