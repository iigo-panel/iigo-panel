@page "/apppools/{name}"
@using Microsoft.Web.Administration
@using IIGO.Services
@inject IISService IISService
@attribute [Authorize(Policy = Feature.ViewAppPools)]
@attribute [StreamRendering]
@rendermode InteractiveServer


@if (appPool == null)
{
	<LoadingState />
}
else
{
	<PageTitle>Application Pool: @appPool.Name</PageTitle>

	<PageHeader Title="@appPool.Name" Subtitle="Application pool" ParentText="App Pools" ParentHref="/apppools" />

	<SectionCard Title="Settings">
		<dl class="kv-list">
			<dt>Enable 32-bit</dt>
			<dd>@appPool.Enable32BitAppOnWin64</dd>
			<dt>Maximum Memory</dt>
			<dd>@appPool.Recycling.PeriodicRestart.Memory</dd>
			<dt>CPU Limit</dt>
			<dd>@appPool.Cpu.Limit</dd>
			<dt>CPU Limit Action</dt>
			<dd>@appPool.Cpu.Action.ToString()</dd>
		</dl>
	</SectionCard>
}

@code {
	private ApplicationPool? appPool;

	[Parameter]
	public string Name { get; set; } = "";

	protected override void OnInitialized()
	{
		appPool = IISService.GetAppPool(Name);
	}
}