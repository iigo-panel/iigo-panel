@page "/apppools/{name}"
@using Microsoft.Web.Administration
@using IIGO.Services
@inject IISService IISService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<AppPool> logger
@attribute [Authorize(Policy = Feature.ViewAppPools)]
@attribute [StreamRendering]
@rendermode InteractiveServer

<a href="/apppools">&laquo; Back to List</a>

@if (!loaded)
{
	<p><em>Loading...</em></p>
}
else if (appPool == null)
{
	<PageTitle>Application Pool</PageTitle>

	<h1>Application Pool: @Name</h1>
	<div class="alert alert-danger mt-3">Application pool "@Name" was not found.</div>
}
else
{
	<PageTitle>Application Pool: @appPool.Name</PageTitle>

	<h1>Application Pool: @appPool.Name</h1>

	@if (LastMessage != null)
	{
		<div class="alert alert-@(Success ? "success" : "danger") mt-3">
			@LastMessage
		</div>
	}

	<div class="container">
		<div class="row">
			<div class="col-10">
				<h3>Details</h3>
				<dl>
					<dt>Status</dt>
					<dd>@appPool.State</dd>
					<dt>.NET CLR version</dt>
					<dd>@(string.IsNullOrEmpty(appPool.ManagedRuntimeVersion) ? "No Managed Code" : appPool.ManagedRuntimeVersion)</dd>
					<dt>Managed pipeline mode</dt>
					<dd>@appPool.ManagedPipelineMode</dd>
					<dt>Enable 32-bit applications</dt>
					<dd>@YesNo(appPool.Enable32BitAppOnWin64)</dd>
					<dt>Start mode</dt>
					<dd>@appPool.StartMode</dd>
					<dt>Start automatically</dt>
					<dd>@YesNo(appPool.AutoStart)</dd>
					<dt>Applications</dt>
					<dd><a href="/apppools/@appPool.Name/applications">@applicationCount</a></dd>
				</dl>
			</div>
			<div class="col-2">
				<div class="row">
					<div class="col-6">
						<button @onclick="Reload" class="btn btn-secondary">Reload</button>
					</div>
					@if (canEdit)
					{
						<div class="col-6">
							<button @onclick="RecyclePool" class="btn btn-primary">Recycle</button>
						</div>
						@if (appPool.State == ObjectState.Stopped)
						{
							<div class="col-6 mt-2">
								<button @onclick="StartPool" class="btn btn-success">Start</button>
							</div>
						}
						@if (appPool.State == ObjectState.Started)
						{
							<div class="col-6 mt-2">
								<button @onclick="StopPool" class="btn btn-danger">Stop</button>
							</div>
						}
					}
				</div>
			</div>
		</div>

		<h3 class="mt-4">Identity</h3>
		<dl>
			<dt>Identity type</dt>
			<dd>@appPool.ProcessModel.IdentityType</dd>
			@if (appPool.ProcessModel.IdentityType == ProcessModelIdentityType.SpecificUser)
			{
				<dt>User name</dt>
				<dd>@appPool.ProcessModel.UserName</dd>
			}
			<dt>Load user profile</dt>
			<dd>@YesNo(appPool.ProcessModel.LoadUserProfile)</dd>
		</dl>

		<h3 class="mt-4">Process Model</h3>
		<dl>
			<dt>Idle time-out</dt>
			<dd>@DurationText(appPool.ProcessModel.IdleTimeout)</dd>
			<dt>Idle time-out action</dt>
			<dd>@appPool.ProcessModel.IdleTimeoutAction</dd>
			<dt>Maximum worker processes</dt>
			<dd>@appPool.ProcessModel.MaxProcesses</dd>
			<dt>Ping enabled</dt>
			<dd>@YesNo(appPool.ProcessModel.PingingEnabled)</dd>
			<dt>Ping interval</dt>
			<dd>@DurationText(appPool.ProcessModel.PingInterval)</dd>
			<dt>Ping maximum response time</dt>
			<dd>@DurationText(appPool.ProcessModel.PingResponseTime)</dd>
			<dt>Start-up time limit</dt>
			<dd>@DurationText(appPool.ProcessModel.StartupTimeLimit)</dd>
			<dt>Shutdown time limit</dt>
			<dd>@DurationText(appPool.ProcessModel.ShutdownTimeLimit)</dd>
		</dl>

		<h3 class="mt-4">Recycling</h3>
		<dl>
			<dt>Regular time interval</dt>
			<dd>@DurationText(appPool.Recycling.PeriodicRestart.Time)</dd>
			<dt>Specific times</dt>
			<dd>@scheduleText</dd>
			<dt>Request limit</dt>
			<dd>@LimitText(appPool.Recycling.PeriodicRestart.Requests, "")</dd>
			<dt>Virtual memory limit</dt>
			<dd>@LimitText(appPool.Recycling.PeriodicRestart.Memory, " KB")</dd>
			<dt>Private memory limit</dt>
			<dd>@LimitText(appPool.Recycling.PeriodicRestart.PrivateMemory, " KB")</dd>
			<dt>Disable overlapped recycle</dt>
			<dd>@YesNo(appPool.Recycling.DisallowOverlappingRotation)</dd>
			<dt>Disable recycling on configuration changes</dt>
			<dd>@YesNo(appPool.Recycling.DisallowRotationOnConfigChange)</dd>
		</dl>

		<h3 class="mt-4">CPU</h3>
		<dl>
			<dt>Limit</dt>
			<dd>@(appPool.Cpu.Limit == 0 ? "No limit" : $"{appPool.Cpu.Limit / 1000.0:0.###}%")</dd>
			<dt>Limit action</dt>
			<dd>@appPool.Cpu.Action</dd>
			<dt>Limit interval</dt>
			<dd>@DurationText(appPool.Cpu.ResetInterval)</dd>
		</dl>

		<h3 class="mt-4">Rapid-Fail Protection</h3>
		<dl>
			<dt>Enabled</dt>
			<dd>@YesNo(appPool.Failure.RapidFailProtection)</dd>
			<dt>Maximum failures</dt>
			<dd>@appPool.Failure.RapidFailProtectionMaxCrashes</dd>
			<dt>Failure interval</dt>
			<dd>@DurationText(appPool.Failure.RapidFailProtectionInterval)</dd>
		</dl>

		<h3 class="mt-4">Worker Processes</h3>
		@if (workerProcesses.Count == 0)
		{
			<p><em>No worker processes are running.</em></p>
		}
		else
		{
			<table class="table">
				<thead>
					<tr>
						<th>Process Id</th>
						<th>State</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var wp in workerProcesses)
					{
						<tr>
							<td>@wp.ProcessId</td>
							<td>@wp.State</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

@code {
	private ApplicationPool? appPool;
	private bool loaded;
	private bool canEdit;
	private int applicationCount;
	private string scheduleText = "None";
	private List<(int ProcessId, WorkerProcessState State)> workerProcesses = [];
	private string? LastMessage = null;
	private bool Success = true;

	[Parameter]
	public string Name { get; set; } = "";

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		canEdit = (await AuthorizationService.AuthorizeAsync(authState.User, Feature.EditAppPools)).Succeeded;
		Load();
	}

	private void Load()
	{
		appPool = IISService.GetAppPool(Name);
		applicationCount = IISService.GetApplicationCountsByPool().GetValueOrDefault(Name, 0);
		scheduleText = "None";
		workerProcesses = [];
		if (appPool != null)
		{
			try
			{
				var times = appPool.Recycling.PeriodicRestart.Schedule.Select(x => x.Time).OrderBy(x => x).ToList();
				if (times.Count > 0)
					scheduleText = string.Join(", ", times.Select(x => x.ToString(@"hh\:mm")));
			}
			catch (Exception ex)
			{
				logger.LogError(ex, "Error loading recycle schedule for application pool {Name}", Name);
			}

			try
			{
				workerProcesses = [.. appPool.WorkerProcesses.Select(x => (x.ProcessId, x.State))];
			}
			catch (Exception ex)
			{
				logger.LogError(ex, "Error loading worker processes for application pool {Name}", Name);
			}
		}
		loaded = true;
	}

	protected void Reload()
	{
		LastMessage = null;
		Load();
	}

	// Checked again in each handler so only users with EditAppPools can change a pool, whatever the UI shows
	protected void RecyclePool()
	{
		if (!canEdit)
			return;

		Run(() => IISService.Recycle(Name), "recycled");
	}

	protected void StartPool()
	{
		if (!canEdit)
			return;

		Run(() => IISService.StartPool(Name), "started");
	}

	protected void StopPool()
	{
		if (!canEdit)
			return;

		Run(() => IISService.StopPool(Name), "stopped");
	}

	private void Run(Action action, string done)
	{
		try
		{
			action();
			LastMessage = $"{Name} {done}.";
			Success = true;
		}
		catch (Exception ex)
		{
			logger.LogError(ex, "Error changing application pool {Name}", Name);
			LastMessage = $"{Name} was not {done}: {ex.Message}";
			Success = false;
		}
		Load();
	}

	private static string YesNo(bool value) => value ? "Yes" : "No";

	private static string DurationText(TimeSpan value) => value == TimeSpan.Zero ? "0 (disabled)" : value.ToString();

	private static string LimitText(long value, string unit) => value == 0 ? "No limit" : $"{value:N0}{unit}";
}
