@page "/services"
@using System.ServiceProcess
@using IIGO.Services
@inject WindowsServiceManager ServiceManager
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Services> logger
@attribute [Authorize(Policy = Feature.ViewServices)]
@attribute [StreamRendering]
@rendermode InteractiveServer

<PageTitle>Services</PageTitle>

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />
<ConfirmDialog @ref="dialog" />

@if (services == null)
{
    <PageHeader Title="Services" />

    <LoadingState />
}
else
{
    <PageHeader Title="Services">
        <Actions>
            @if (isAdmin)
            {
                <button @onclick="AddService" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Service</button>
            }
            <button @onclick="Refresh" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Refresh</button>
        </Actions>
    </PageHeader>

    <SectionCard Flush="true">
        <div class="d-flex flex-wrap align-items-center gap-2 p-3 border-bottom">
            <div class="input-group mw-input">
                <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input type="search" class="form-control" placeholder="Filter services" aria-label="Filter services"
                       @bind="filter" @bind:event="oninput" />
            </div>
            <span class="text-body-secondary small">@FilteredServices.Count() of @services.Count services</span>
        </div>
        <div class="table-scroll">
            <table class="table table-hover align-middle iigo-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Startup Type</th>
                        <th>Log On As</th>
                        @if (HasActions)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var service in FilteredServices)
                    {
                        bool busy = busyServices.Contains(service.Name);
                        <tr>
                            <td><div class="cell-truncate" title="@($"{service.DisplayName} ({service.Name})")">@service.DisplayName</div></td>
                            <td><div class="cell-truncate cell-truncate-lg" title="@service.Description">@service.Description</div></td>
                            <td><StatusBadge Status="@service.Status.ToString()" Variant="@(service.IsStopped ? "secondary" : null)" /></td>
                            <td>@service.StartupText</td>
                            <td>@service.LogOnText</td>
                            @if (HasActions)
                            {
                                <td class="text-end">
                                    <div class="row-actions">
                                        @if (busy)
                                        {
                                            <span class="spinner-border spinner-border-sm text-body-secondary" role="status" aria-label="Working"></span>
                                        }
                                        @if (canControl && service.IsStopped && service.StartMode != ServiceStartMode.Disabled)
                                        {
                                            <button @onclick="@(() => StartService(service))" disabled="@busy" class="btn btn-sm btn-outline-success"><i class="bi bi-play-fill me-1" aria-hidden="true"></i>Start</button>
                                        }
                                        @if (canControl && service.IsRunning && service.CanStop && !service.IsSelf)
                                        {
                                            <button @onclick="@(() => RestartService(service))" disabled="@busy" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Restart</button>
                                        }
                                        @if (isAdmin && !service.IsStopped && service.CanStop && !service.IsSelf)
                                        {
                                            <button @onclick="@(() => StopService(service))" disabled="@busy" class="btn btn-sm btn-outline-danger"><i class="bi bi-stop-fill me-1" aria-hidden="true"></i>Stop</button>
                                        }
                                        @if (isAdmin)
                                        {
                                            <button @onclick="@(() => EditService(service))" disabled="@busy" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit</button>
                                            @if (!service.IsSelf)
                                            {
                                                <button @onclick="@(() => DeleteService(service))" disabled="@busy" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete</button>
                                            }
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </SectionCard>

    @if (isAdmin)
    {
        <Modal @ref="serviceModal" Title="@(editingService == null ? "Add Service" : "Edit Service")" Size="ModalSize.Large">
            <BodyTemplate>
                <EditForm Model="serviceForm" OnValidSubmit="SaveService">
                    <DataAnnotationsValidator />
                    @if (ModalError != null)
                    {
                        <div class="alert alert-danger">@ModalError</div>
                    }
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <InputText class="form-control" @bind-Value="serviceForm.Name" id="serviceName" placeholder="Service name" disabled="@(editingService != null)" />
                                <label for="serviceName">Service name</label>
                            </div>
                            <ValidationMessage For="() => serviceForm.Name" class="text-danger" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <InputText class="form-control" @bind-Value="serviceForm.DisplayName" id="serviceDisplayName" placeholder="Display name" />
                                <label for="serviceDisplayName">Display name</label>
                            </div>
                            <ValidationMessage For="() => serviceForm.DisplayName" class="text-danger" />
                        </div>
                    </div>
                    <div class="form-floating mb-3">
                        <InputText class="form-control" @bind-Value="serviceForm.Description" id="serviceDescription" placeholder="Description" />
                        <label for="serviceDescription">Description (optional)</label>
                    </div>
                    <div class="form-floating mb-1">
                        <InputText class="form-control" @bind-Value="serviceForm.BinaryPath" id="serviceBinaryPath" placeholder="Path to executable" />
                        <label for="serviceBinaryPath">Path to executable</label>
                    </div>
                    <ValidationMessage For="() => serviceForm.BinaryPath" class="text-danger" />
                    <div class="form-text mb-3">Example: "C:\Program Files\App\app.exe" --service. Put quotes around a path with spaces.</div>
                    <div class="form-floating mb-3">
                        <InputSelect class="form-select" @bind-Value="serviceForm.StartupType" id="serviceStartupType">
                            <option value="@ServiceStartupType.Automatic">Automatic</option>
                            <option value="@ServiceStartupType.AutomaticDelayed">Automatic (Delayed Start)</option>
                            <option value="@ServiceStartupType.Manual">Manual</option>
                            <option value="@ServiceStartupType.Disabled">Disabled</option>
                        </InputSelect>
                        <label for="serviceStartupType">Startup type</label>
                    </div>
                    <div class="form-floating mb-3">
                        <InputSelect class="form-select" @bind-Value="serviceForm.LogOnType" id="serviceLogOnType">
                            <option value="@ServiceLogOnType.LocalSystem">Local System</option>
                            <option value="@ServiceLogOnType.LocalService">Local Service</option>
                            <option value="@ServiceLogOnType.NetworkService">Network Service</option>
                            <option value="@ServiceLogOnType.Account">This account</option>
                        </InputSelect>
                        <label for="serviceLogOnType">Log on as</label>
                    </div>
                    @if (serviceForm.LogOnType == ServiceLogOnType.Account)
                    {
                        <div class="form-floating mb-1">
                            <InputText class="form-control" @bind-Value="serviceForm.AccountName" id="serviceAccount" placeholder="Account" autocomplete="off" />
                            <label for="serviceAccount">Account</label>
                        </div>
                        <ValidationMessage For="() => serviceForm.AccountName" class="text-danger" />
                        <div class="form-text mb-3">Example: DOMAIN\user, user@domain or a local user name.</div>
                        <div class="row g-2 mb-1">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText type="password" class="form-control" @bind-Value="serviceForm.Password" id="servicePassword" placeholder="Password" autocomplete="new-password" />
                                    <label for="servicePassword">Password</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText type="password" class="form-control" @bind-Value="serviceForm.ConfirmPassword" id="serviceConfirmPassword" placeholder="Confirm password" autocomplete="new-password" />
                                    <label for="serviceConfirmPassword">Confirm password</label>
                                </div>
                            </div>
                        </div>
                        <ValidationMessage For="() => serviceForm.ConfirmPassword" class="text-danger" />
                        <div class="form-text mb-3">
                            @if (editingService != null)
                            {
                                <text>Leave blank to keep the current password. </text>
                            }
                            Managed and virtual service accounts don't need a password.
                        </div>
                    }
                    @if (editingService != null)
                    {
                        <div class="form-text">Changes take effect the next time the service starts.</div>
                    }
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" @onclick="@(() => serviceModal.HideAsync())" class="btn btn-outline-secondary">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </EditForm>
            </BodyTemplate>
        </Modal>
    }
}

@code {
    private ConfirmDialog dialog = default!;
    private Modal serviceModal = default!;

    List<WindowsServiceInfo>? services;
    readonly HashSet<string> busyServices = new(StringComparer.OrdinalIgnoreCase);
    string filter = "";
    // Start and Restart are a configurable permission; Add, Edit, Delete and Stop are for administrators only
    bool canControl;
    bool isAdmin;
    string actor = "";
    private string? ModalError = null;

    private WindowsServiceModel serviceForm = new();
    private WindowsServiceInfo? editingService;

    bool HasActions => canControl || isAdmin;

    // Every word typed has to match somewhere in the service
    private IEnumerable<WindowsServiceInfo> FilteredServices
    {
        get
        {
            var terms = filter.ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return services!.Where(service => terms.All(service.SearchText.Contains));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        isAdmin = user.IsInRole("Administrator");
        canControl = (await AuthorizationService.AuthorizeAsync(user, Feature.StartRestartServices)).Succeeded;
        actor = user.Identity?.Name ?? "";
        await Refresh();
    }

    private async Task Refresh()
    {
        services = await Task.Run(ServiceManager.GetServices);
    }

    protected async Task StartService(WindowsServiceInfo service)
    {
        if (!canControl)
            return;

        logger.LogWarning("{Actor} is starting service {ServiceName}", actor, service.Name);
        await RunAction(service, "Start", () => ServiceManager.StartServiceAsync(service.Name), "started");
    }

    protected async Task RestartService(WindowsServiceInfo service)
    {
        if (!canControl || service.IsSelf)
            return;

        logger.LogWarning("{Actor} is restarting service {ServiceName}", actor, service.Name);
        await RunAction(service, "Restart", () => ServiceManager.RestartServiceAsync(service.Name), "restarted");
    }

    protected async Task StopService(WindowsServiceInfo service)
    {
        if (!isAdmin || service.IsSelf)
            return;

        var confirmation = await dialog.ShowAsync(
            title: "Are you sure you want to stop this service?",
            message1: $"{service.DisplayName} will stop, along with any services that depend on it.",
            message2: "Do you want to proceed?");

        if (!confirmation)
            return;

        logger.LogWarning("{Actor} is stopping service {ServiceName}", actor, service.Name);
        await RunAction(service, "Stop", () => ServiceManager.StopServiceAsync(service.Name), "stopped");
    }

    protected async Task DeleteService(WindowsServiceInfo service)
    {
        if (!isAdmin || service.IsSelf)
            return;

        var confirmation = await dialog.ShowAsync(
            title: "Are you sure you want to delete this service?",
            message1: $"{service.DisplayName} ({service.Name}) will be stopped and removed from Windows. This can't be undone.",
            message2: "Do you want to proceed?");

        if (!confirmation)
            return;

        logger.LogWarning("{Actor} is deleting service {ServiceName}", actor, service.Name);
        await RunAction(service, "Delete", () => ServiceManager.DeleteServiceAsync(service.Name), "deleted");
    }

    private async Task RunAction(WindowsServiceInfo service, string action, Func<Task> work, string doneText)
    {
        busyServices.Add(service.Name);
        try
        {
            await work();
            ShowMessage($"{service.DisplayName} {doneText}.", "Success", ToastType.Success);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error running {Action} on service {ServiceName}", action, service.Name);
            ShowMessage($"{action} failed for {service.DisplayName}: {ex.InnerException?.Message ?? ex.Message}", "Error", ToastType.Danger);
        }
        finally
        {
            busyServices.Remove(service.Name);
        }
        await Refresh();
    }

    protected async Task AddService()
    {
        if (!isAdmin)
            return;

        editingService = null;
        serviceForm = new WindowsServiceModel();
        ModalError = null;
        await serviceModal.ShowAsync();
    }

    protected async Task EditService(WindowsServiceInfo service)
    {
        if (!isAdmin)
            return;

        // Read again so the form starts from the service's current settings
        editingService = ServiceManager.GetService(service.Name);
        if (editingService == null)
        {
            ShowMessage($"{service.DisplayName} no longer exists.", "Error", ToastType.Danger);
            await Refresh();
            return;
        }
        serviceForm = WindowsServiceModel.From(editingService);
        ModalError = null;
        await serviceModal.ShowAsync();
    }

    protected async Task SaveService()
    {
        if (!isAdmin)
            return;

        try
        {
            if (editingService == null)
            {
                ServiceManager.CreateService(serviceForm);
                logger.LogWarning("{Actor} created service {ServiceName}", actor, serviceForm.Name.Trim());
            }
            else
            {
                ServiceManager.UpdateService(editingService, serviceForm);
                logger.LogWarning("{Actor} changed service {ServiceName}", actor, editingService.Name);
            }

            await serviceModal.HideAsync();
            ShowMessage($"{serviceForm.DisplayName.Trim()} saved.", "Success", ToastType.Success);
            serviceForm = new WindowsServiceModel();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error saving service {ServiceName}", serviceForm.Name);
            ModalError = ex.Message;
        }
        await Refresh();
    }

    List<ToastMessage> messages = new List<ToastMessage>();

    private void ShowMessage(string message, string title, ToastType toastType) => messages.Add(CreateToastMessage(message, title, toastType));

    private ToastMessage CreateToastMessage(string message, string title, ToastType toastType)
    => new ToastMessage
    {
        Title = title,
        Type = toastType,
        HelpText = $"{DateTime.Now}",
        Message = message,
    };
}
