@page "/license"
@using IIGO.Services
@inject IHttpContextAccessor httpContextAccessor
@inject IIGO.Plugins.PluginRegistry Plugins
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>License Status</PageTitle>

<PageHeader Title="License Status" />

@if (!isLoaded || licenseData == null)
{
    <div class="alert alert-danger d-flex align-items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div>Invalid License!</div>
    </div>
}
else
{
    <SectionCard Title="License">
        <Actions><StatusBadge Status="@(licenseStatus ? "Valid" : "Invalid")" /></Actions>
        <ChildContent>
            <dl class="kv-list">
                <dt>Company</dt><dd>@licenseData.CompanyName</dd>
                <dt>Initial Version</dt><dd>@licenseData.InitialVersion</dd>
                <dt>Date</dt><dd>@licenseData.LicenseDate</dd>
                <dt>Term</dt><dd>@licenseData.LicenseTerm</dd>
                <dt>Type</dt><dd>@licenseData.LicenseType</dd>
            </dl>
        </ChildContent>
    </SectionCard>
}

<SectionCard Title="Plugins" Subtitle="Loaded at startup. Restart the service after adding, updating or removing one.">
    @if (Plugins.Plugins.Count == 0)
    {
        <p class="mb-0 text-body-secondary">No plugins are loaded.</p>
    }
    else
    {
        <dl class="kv-list">
            @foreach (var plugin in Plugins.Plugins)
            {
                <dt>@plugin.Name</dt><dd>@plugin.Version</dd>
            }
        </dl>
    }
    @foreach (var message in Plugins.Messages.Where(m => m.Level >= LogLevel.Warning))
    {
        <div class="alert @(message.Level >= LogLevel.Error ? "alert-danger" : "alert-warning") mt-3 mb-0">@message.Message</div>
    }
</SectionCard>


@code {
    LicenseData? licenseData;
    bool licenseStatus;
    bool isLoaded = false;

	protected override void OnInitialized()
	{
		licenseStatus = LicenseKeyService.ValidateLicense(out var license);
		licenseData = license;
        isLoaded = true;
	}
}
