@page "/license"
@using IIGO.Services
@inject IHttpContextAccessor httpContextAccessor
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>License Status</PageTitle>

<PageHeader Title="License Status" />

@if (!isLoaded || licenseData == null)
{
    <div class="alert alert-danger d-flex align-items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div>Invalid License!</div>
    </div>
}
else
{
    <SectionCard Title="License">
        <Actions><StatusBadge Status="@(licenseStatus ? "Valid" : "Invalid")" /></Actions>
        <ChildContent>
            <dl class="kv-list">
                <dt>Company</dt><dd>@licenseData.CompanyName</dd>
                <dt>Initial Version</dt><dd>@licenseData.InitialVersion</dd>
                <dt>Date</dt><dd>@licenseData.LicenseDate</dd>
                <dt>Term</dt><dd>@licenseData.LicenseTerm</dd>
                <dt>Type</dt><dd>@licenseData.LicenseType</dd>
                @if (licenseData.LicenseType != LicenseType.Community)
                {
                    <dt>Servers</dt>
                    <dd>@(licenseData.MaxServers is int max ? $"{licenseData.ServerIds?.Length ?? 0} of {max} assigned" : "Unlimited")</dd>
                }
                <dt>This server's ID</dt>
                <dd>
                    @if (ServerIdentity.Id is string serverId)
                    {
                        <code class="user-select-all">@serverId</code>
                        @if (licenseData.MaxServers != null)
                        {
                            <span class="ms-2"><StatusBadge Status="@(licenseData.CoversThisServer ? "Licensed" : "Not licensed")" Variant="@(licenseData.CoversThisServer ? "success" : "warning")" /></span>
                        }
                    }
                    else
                    {
                        <span class="text-body-secondary">Not available</span>
                    }
                </dd>
            </dl>
            @if (!licenseData.CoversThisServer)
            {
                <div class="alert alert-warning mt-3 mb-0">This license doesn't list this server. Send the server ID above to add it to your license.</div>
            }
        </ChildContent>
    </SectionCard>
}

@code {
    LicenseData? licenseData;
    bool licenseStatus;
    bool isLoaded = false;

	protected override void OnInitialized()
	{
		licenseStatus = LicenseKeyService.ValidateLicense(out var license);
		licenseData = license;
        isLoaded = true;
	}
}
