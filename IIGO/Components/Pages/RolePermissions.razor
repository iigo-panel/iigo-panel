@page "/roles/{id}"
@using IIGO.Plugins
@using IIGO.Services
@using Microsoft.AspNetCore.Identity
@inject RoleManager<IdentityRole> _roleManager
@inject RolePermissionService _permissionService
@inject PluginRegistry Plugins
@inject NavigationManager _nav
@inject ILogger<RolePermissions> logger
@attribute [Authorize(Policy = Feature.ViewRoles)]
@rendermode InteractiveServer

<PageTitle>Role Permissions</PageTitle>

@if (role == null)
{
    <PageHeader Title="Role Permissions" />

    <LoadingState />
}
else
{
    <PageHeader Title="Role Permissions" Subtitle="@role.Name" ParentText="Roles" ParentHref="/roles" />

    @foreach (var group in Plugins.FeatureGroups)
    {
        <SectionCard Title="@(group.Name == PluginRegistry.CoreFeatureGroup ? "Features" : group.Name)">
            <div class="row row-cols-1 row-cols-md-2 g-2">
                @foreach (var feature in group.Features)
                {
                    <div class="col">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="@feature"
                                   checked="@selectedFeatures.Contains(feature)"
                                   disabled="@(!isAdmin)"
                                   @onchange="@(e => ToggleFeature(feature, (bool)e.Value!))" />
                            <label class="form-check-label" for="@feature">@FormatFeatureName(feature)</label>
                        </div>
                    </div>
                }
            </div>
        </SectionCard>
    }

    @if (isAdmin)
    {
        <div class="d-flex align-items-center gap-3 mt-3">
            <button class="btn btn-primary" @onclick="Save">Save</button>
            @if (!string.IsNullOrEmpty(saveMessage))
            {
                <span class="text-success">@saveMessage</span>
            }
        </div>
    }
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    IdentityRole? role;
    HashSet<string> selectedFeatures = new();
    string? saveMessage;
    bool isAdmin;
    string actor = "";

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        isAdmin = user.IsInRole("Administrator");
        actor = user.Identity?.Name ?? "";
        role = await _roleManager.FindByIdAsync(Id);
        if (role != null)
        {
            var features = await _permissionService.GetRoleFeaturesAsync(role.Id);
            selectedFeatures = new HashSet<string>(features);
        }
    }

    void ToggleFeature(string feature, bool selected)
    {
        saveMessage = null;
        if (selected)
            selectedFeatures.Add(feature);
        else
            selectedFeatures.Remove(feature);
    }

    // Checked again here so only administrators can change permissions, whatever the UI shows
    async Task Save()
    {
        if (!isAdmin || role == null)
            return;

        await _permissionService.SetRoleFeaturesAsync(role.Id, selectedFeatures);
        logger.LogWarning("{Actor} set permissions of role {RoleName} to [{Features}]", actor, role.Name, string.Join(", ", selectedFeatures.Order()));
        saveMessage = "Saved!";
    }

    static string FormatFeatureName(string feature)
    {
        // Drop a plugin prefix and insert spaces before uppercase letters: "Pro.ViewBackups" -> "View Backups"
        feature = feature[(feature.LastIndexOf('.') + 1)..];
        var result = new System.Text.StringBuilder();
        foreach (var ch in feature)
        {
            if (char.IsUpper(ch) && result.Length > 0)
                result.Append(' ');
            result.Append(ch);
        }
        return result.ToString();
    }
}
