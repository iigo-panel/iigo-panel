@page "/websites"
@using IIGO.Data
@using IIGO.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.Web.Administration
@inject IISService IISService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Websites> logger
@attribute [Authorize(Policy = Feature.ViewWebsites)]
@rendermode InteractiveServer

<PageTitle>Websites</PageTitle>

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

@if (sites == null)
{
    <PageHeader Title="Websites" Subtitle="Sites hosted in IIS on this server." />
    <LoadingState />
}
else
{
    <PageHeader Title="Websites" Subtitle="Sites hosted in IIS on this server.">
        <Actions>
            @if (isAdmin)
            {
                <a href="/websites/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Website</a>
            }
            <button @onclick="Reload" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Reload</button>
            <a href="/httpsmonitor" class="btn btn-outline-secondary"><i class="bi bi-shield-check me-1" aria-hidden="true"></i>HTTPS Monitor</a>
        </Actions>
    </PageHeader>

    <ConfirmDialog @ref="dialog" />

    <SectionCard Flush="true">
        @if (sites.Count == 0)
        {
            <EmptyState Icon="bi-globe2" Title="No websites" Message="IIS has no sites on this server." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle iigo-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Binding</th>
                            <th>Path</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var site in sites)
                        {
                            var path = site.Applications[0].VirtualDirectories[0].PhysicalPath;
                            var bindings = String.Join(";", site.Bindings.Select(x => x.BindingInformation));
                            <tr>
                                <td class="text-body-secondary tabular-nums">@site.Id</td>
                                <td><a class="fw-semibold" href="/websites/@site.Id">@site.Name</a></td>
                                <td><StatusBadge Status="@site.State.ToString()" /></td>
                                <td><div class="cell-truncate" title="@bindings">@bindings</div></td>
                                <td><div class="cell-truncate" title="@path">@path</div></td>
                                <td class="text-end">
                                    <div class="row-actions">
                                        @if (isAdmin)
                                        {
                                            <button @onclick="@(e => RestartSite(site.Id))" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Restart</button>
                                            @if (site.State == ObjectState.Stopped)
                                            {
                                                <button @onclick="@(e => StartSite(site.Id))" class="btn btn-sm btn-outline-success"><i class="bi bi-play-fill me-1" aria-hidden="true"></i>Start</button>
                                            }
                                            else if (site.State == ObjectState.Started)
                                            {
                                                <button @onclick="@(e => StopSite(site.Id))" class="btn btn-sm btn-outline-danger"><i class="bi bi-stop-fill me-1" aria-hidden="true"></i>Stop</button>
                                            }
                                            <button @onclick="@(e => DeleteSite(site.Id))" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </SectionCard>
}

@code{
    private ConfirmDialog dialog = default!;
    List<Site>? sites;
    private string? LastMessage = null;
    private bool Success = true;
    // From the circuit's authentication state; HttpContext isn't reliable inside an interactive circuit
    private bool isAdmin;
    private string actor = "";

    protected async Task Reload()
    {
        try
        {
            sites = IISService.GetSites();
        }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        isAdmin = user.IsInRole("Administrator");
        actor = user.Identity?.Name ?? "";
        try
        {
            sites = IISService.GetSites();
        }
        catch { }
    }

    // Checked again in each handler so only administrators can change a site, whatever the UI shows
    protected void RestartSite(long siteId)
    {
        if (!isAdmin)
            return;

        try
        {
            var site = IISService.GetSite(siteId);
            ShowMessage($"{site?.Name} restarted!", "Success", ToastType.Success);
        }
        catch {}
        logger.LogInformation("{Actor} restarted site {SiteId}", actor, siteId);
        IISService.RestartSite(siteId);
    }

    protected void StartSite(long siteId)
    {
        if (!isAdmin)
            return;

        try
        {
            var site = IISService.GetSite(siteId);
            ShowMessage($"{site?.Name} started!", "Success", ToastType.Success);
        }
        catch { }
        logger.LogInformation("{Actor} started site {SiteId}", actor, siteId);
        IISService.StartSite(siteId);
    }

    protected void StopSite(long siteId)
    {
        if (!isAdmin)
            return;

        try
        {
            var site = IISService.GetSite(siteId);
            ShowMessage($"{site?.Name} stopped!", "Success", ToastType.Success);
        }
        catch { }
        logger.LogInformation("{Actor} stopped site {SiteId}", actor, siteId);
        IISService.StopSite(siteId);
    }

    protected async Task DeleteSite(long siteId)
    {
        if (!isAdmin)
            return;

        var confirmation = await dialog.ShowAsync(
            title: "Are you sure you want to delete this website?",
            message1: "This will delete the website and cannot be reversed.",
            message2: "Do you want to proceed?");

        if (confirmation)
        {
            string? siteName = null;
            try
            {
                var site = IISService.GetSite(siteId);
                siteName = site?.Name;
            }
            catch { }

            try
            {
                IISService.DeleteWebsite(siteId);
                logger.LogWarning("{Actor} deleted site {SiteName} ({SiteId})", actor, siteName, siteId);
                ShowMessage($"{siteName} deleted!", "Success", ToastType.Success);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error deleting site {SiteName} ({SiteId})", siteName, siteId);
                ShowMessage($"Delete failed: {ex.Message}", "Error", ToastType.Danger);
            }

            try
            {
                sites = IISService.GetSites();
            }
            catch { }
            await InvokeAsync(StateHasChanged);
        }
    }

    List<ToastMessage> messages = new List<ToastMessage>();

    private void ShowMessage(string message, string title, ToastType toastType) => messages.Add(CreateToastMessage(message, title, toastType));

    private ToastMessage CreateToastMessage(string message, string title, ToastType toastType)
    => new ToastMessage
    {
        Title = title,
        Type = toastType,
        HelpText = $"{DateTime.Now}",
        Message = message,
    };
}