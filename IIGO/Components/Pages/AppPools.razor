@page "/apppools"
@using IIGO.Services
@using System.Timers
@using Microsoft.Web.Administration
@inject IISService IISService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Policy = Feature.ViewAppPools)]
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Application Pools</PageTitle>

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />

@if (pools == null)
{
    <PageHeader Title="Application Pools" Subtitle="Refreshes every 5 seconds." />
    <LoadingState />
}
else
{
    <PageHeader Title="Application Pools" Subtitle="Refreshes every 5 seconds.">
        <Actions>
            <a href="/apppoolmonitor" class="btn btn-outline-secondary"><i class="bi bi-heart-pulse me-1" aria-hidden="true"></i>Monitor</a>
        </Actions>
    </PageHeader>

    <SectionCard Flush="true">
        <div class="table-responsive">
            <table class="table table-hover align-middle iigo-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Identity</th>
                        <th>Applications</th>
                        @if (canEdit)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pool in pools)
                    {
                        <tr>
                            <td><a class="fw-semibold" href="/apppools/@pool.Name">@pool.Name</a></td>
                            <td><StatusBadge Status="@pool.State.ToString()" /></td>
                            <td>@(pool.ProcessModel.IdentityType == ProcessModelIdentityType.SpecificUser ? pool.ProcessModel.UserName : pool.ProcessModel.IdentityType)</td>
                            <td><a class="badge rounded-pill text-primary-emphasis bg-primary-subtle text-decoration-none" href="/apppools/@pool.Name/applications">@(appCounts.GetValueOrDefault(pool.Name, 0))</a></td>
                            @if (canEdit)
                            {
                                <td class="text-end">
                                    <div class="row-actions">
                                        <button @onclick="@(e => RecyclePool(pool.Name))" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Recycle</button>
                                        @if (pool.State == ObjectState.Stopped)
                                        {
                                            <button @onclick="@(e => StartPool(pool.Name))" class="btn btn-sm btn-outline-success"><i class="bi bi-play-fill me-1" aria-hidden="true"></i>Start</button>
                                        }
                                        @if (pool.State == ObjectState.Started)
                                        {
                                            <button @onclick="@(e => StopPool(pool.Name))" class="btn btn-sm btn-outline-danger"><i class="bi bi-stop-fill me-1" aria-hidden="true"></i>Stop</button>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </SectionCard>
}

@code {
    List<ApplicationPool>? pools = null;
    Dictionary<string, int> appCounts = new();
    private Timer timer = new(5000);
    private bool Success = true;
    private bool canEdit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        canEdit = (await AuthorizationService.AuthorizeAsync(authState.User, Feature.EditAppPools)).Succeeded;
        pools = IISService.GetAppPools();
        appCounts = IISService.GetApplicationCountsByPool();
        timer.Elapsed += async (sender, eventArgs) => await UpdateValues();
        timer.Start();
    }

    protected async Task UpdateValues()
    {
        pools = IISService.GetAppPools();
        appCounts = IISService.GetApplicationCountsByPool();
        await InvokeAsync(StateHasChanged);
    }

    // Checked again in each handler so only users with EditAppPools can change a pool, whatever the UI shows
    protected void RecyclePool(string poolName)
    {
        if (!canEdit)
            return;

        try
        {
            ShowMessage($"{poolName} recycled!", "Success", ToastType.Success);
        }
        catch(JSDisconnectedException){}
        IISService.Recycle(poolName);
    }

    protected void StartPool(string poolName)
    {
        if (!canEdit)
            return;

        try
        {
            ShowMessage($"{poolName} started!", "Success", ToastType.Success);
        }
        catch (JSDisconnectedException) { }
        IISService.StartPool(poolName);
    }

    protected void StopPool(string poolName)
    {
        if (!canEdit)
            return;

        try
        {
            ShowMessage($"{poolName} stopped", "Success", ToastType.Success);
        }
        catch (JSDisconnectedException) { }
        IISService.StopPool(poolName);
    }

    // Stop refreshing when the user leaves the page
    public void Dispose() => timer.Dispose();

    List<ToastMessage> messages = new List<ToastMessage>();

    private void ShowMessage(string message, string title, ToastType toastType) => messages.Add(CreateToastMessage(message, title, toastType));

    private ToastMessage CreateToastMessage(string message, string title, ToastType toastType)
    => new ToastMessage
        {
            Title = title,
            Type = toastType,
            HelpText = $"{DateTime.Now}",
            Message = message,
        };
}