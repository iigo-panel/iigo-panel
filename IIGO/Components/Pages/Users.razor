@page "/users"
@using IIGO.Data
@using IIGO.Services
@using Microsoft.AspNetCore.Identity
@inject NavigationManager _nav
@inject UserManager<ApplicationUser> _userManager
@inject UserManagementService _userService
@inject ILogger<Users> logger
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer

<PageTitle>Users</PageTitle>

<PageHeader Title="Users">
    <Actions>
        <a href="/users/new" class="btn btn-primary"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Add User</a>
    </Actions>
</PageHeader>

<ConfirmDialog @ref="dialog" />

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger d-flex align-items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div>@errorMessage</div>
    </div>
}

@if (users == null)
{
    <LoadingState />
}
else
{
    <SectionCard Flush="true">
        <div class="table-responsive">
            <table class="table table-hover align-middle iigo-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>MFA</th>
                        <th class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td class="fw-semibold">@user.UserName</td>
                            <td>@user.Email</td>
                            <td>
                                @foreach (var role in userRoles.GetValueOrDefault(user.Id, []))
                                {
                                    <span class="badge text-secondary-emphasis bg-secondary-subtle border border-secondary-subtle me-1">@role</span>
                                }
                            </td>
                            <td>
                                <StatusBadge Status="@(user.TwoFactorEnabled ? "Enabled" : "Off")" />
                            </td>
                            <td class="text-end">
                                <div class="row-actions">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _nav.NavigateTo($"/users/{user.Id}"))"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteUser(user.Id)"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </SectionCard>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private ConfirmDialog dialog = default!;
    List<ApplicationUser>? users;
    Dictionary<string, IList<string>> userRoles = new();
    string? errorMessage;
    string actor = "";

    protected override async Task OnInitializedAsync()
    {
        actor = (await AuthState).User.Identity?.Name ?? "";
        await LoadUsers();
    }

    async Task LoadUsers()
    {
        var list = _userManager.Users.OrderBy(x => x.UserName).ToList();
        var roles = new Dictionary<string, IList<string>>();
        foreach (var user in list)
        {
            roles[user.Id] = await _userManager.GetRolesAsync(user);
        }
        userRoles = roles;
        users = list;
    }

    async Task DeleteUser(string id)
    {
        errorMessage = null;
        bool confirmed = await dialog.ShowAsync(
            title: "Are you sure you want to delete this user?",
            message1: "This can't be undone.",
            message2: "Do you want to proceed?");
        if (confirmed)
        {
            var u = await _userManager.FindByIdAsync(id);
            if (u != null)
            {
                var result = await _userService.DeleteUserAsync(u);
                if (result.Succeeded)
                {
                    logger.LogWarning("{Actor} deleted user {UserName}", actor, u.UserName);
                }
                else
                {
                    errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                }
                await LoadUsers();
            }
        }
    }
}
