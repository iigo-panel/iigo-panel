@page "/apikeys"
@using IIGO.Data
@using IIGO.Services
@using System.ComponentModel.DataAnnotations
@inject ApiKeyService apiKeyService
@inject IJSRuntime JsRuntime
@inject ILogger<ApiKeys> logger
@attribute [Authorize(Policy = Feature.ViewApiKeys)]
@rendermode InteractiveServer

<PageTitle>API Keys</PageTitle>

<PageHeader Title="API Keys" />

<Toasts class="p-3" Messages="messages" AutoHide="true" Delay="3000" Placement="ToastsPlacement.TopRight" />
<ConfirmDialog @ref="dialog" />

<p class="text-body-secondary">Keys are sent in the <code>X-API-KEY</code> header. Only a hash of each key is stored, so a key can't be shown again after it's created. Give each key only what it needs. Read allows GET requests. Where an area offers it, a level such as "Read, start, stop &amp; recycle" allows those actions without creating, changing or deleting anything.</p>

@if (isAdmin)
{
    @if (newKey != null)
    {
        <div class="alert alert-success">
            <p class="mb-2"><i class="bi bi-key-fill me-1" aria-hidden="true"></i><strong>Copy this key now.</strong> It won't be shown again.</p>
            <div class="input-group">
                <input class="form-control font-monospace" readonly value="@newKey" aria-label="New API key" />
                <button class="btn btn-outline-secondary" @onclick="CopyKey"><i class="bi bi-clipboard me-1" aria-hidden="true"></i>Copy</button>
            </div>
            <button class="btn btn-link px-0 mt-2" @onclick="() => newKey = null">I've saved the key</button>
        </div>
    }

    <SectionCard Title="Create a key" Class="mb-3">
        <EditForm Model="NewKey" OnValidSubmit="CreateKey" FormName="NewApiKey">
            <DataAnnotationsValidator />
            <div class="row g-3 align-items-start">
                <div class="col-md-5">
                    <div class="form-floating">
                        <InputText class="form-control" @bind-Value="NewKey.Name" id="keyName" autocomplete="off" placeholder="Name" />
                        <label for="keyName">Name</label>
                    </div>
                    <ValidationMessage For="() => NewKey.Name" class="text-danger" />
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <InputDate class="form-control" @bind-Value="NewKey.ExpiresOn" id="keyExpires" />
                        <label for="keyExpires">Expires (optional)</label>
                    </div>
                    <ValidationMessage For="() => NewKey.ExpiresOn" class="text-danger" />
                </div>
            </div>
            <div class="mt-3">
                <ApiScopeEditor Selection="NewKey.Scopes" IdPrefix="new-key" />
                <ValidationMessage For="() => NewKey.Scopes" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create Key</button>
        </EditForm>
    </SectionCard>

    <Modal @ref="scopesModal" Title="@($"Permissions for {editingKey?.Name}")" Size="ModalSize.Large">
        <BodyTemplate>
            @if (editingKey != null)
            {
                @if (scopesError != null)
                {
                    <div class="alert alert-danger">@scopesError</div>
                }
                <p class="text-body-secondary">Changes apply to the key's next request.</p>
                <ApiScopeEditor Selection="editingScopes" IdPrefix="edit-key" />
            }
        </BodyTemplate>
        <FooterTemplate>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => scopesModal.HideAsync()">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveScopes">Save</button>
        </FooterTemplate>
    </Modal>
}

@if (keys == null)
{
    <LoadingState />
}
else if (keys.Count == 0)
{
    <SectionCard>
        <EmptyState Icon="bi-key" Title="No API keys have been created." />
    </SectionCard>
}
else
{
    <SectionCard Flush="true">
        <div class="table-responsive">
            <table class="table table-hover align-middle iigo-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Key</th>
                        <th>Permissions</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Expires</th>
                        <th>Last Used</th>
                        @if (isAdmin)
                        {
                            <th class="text-end"><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var key in keys)
                    {
                        <tr>
                            <td class="fw-semibold">@key.Name</td>
                            <td class="font-monospace">@key.KeyPrefix…</td>
                            <td>
                                @if (ApiScopes.IsFullAccess(key.Scopes))
                                {
                                    <span class="badge text-bg-warning">Full access</span>
                                }
                                else
                                {
                                    <small>@ApiScopes.Describe(key.Scopes)</small>
                                }
                            </td>
                            <td><StatusBadge Status="@Status(key)" /></td>
                            <td>@key.CreatedAt.ToLocalTime().ToString("g")<br /><small class="text-body-secondary">@key.CreatedBy</small></td>
                            <td>@(key.ExpiresAt?.ToLocalTime().ToString("d") ?? "Never")</td>
                            <td>@(key.LastUsedAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                            @if (isAdmin)
                            {
                                <td class="text-end">
                                    <div class="row-actions">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditScopes(key)"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Permissions</button>
                                        @if (key.Enabled)
                                        {
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => SetEnabled(key, false)"><i class="bi bi-toggle-off me-1" aria-hidden="true"></i>Disable</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => SetEnabled(key, true)"><i class="bi bi-toggle-on me-1" aria-hidden="true"></i>Enable</button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteKey(key)"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete</button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </SectionCard>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private ConfirmDialog dialog = default!;
    private Modal scopesModal = default!;
    ApiKey? editingKey;
    ApiScopeSelection editingScopes = new();
    string? scopesError;
    List<ApiKey>? keys;
    NewKeyModel NewKey = new();
    string? newKey;
    bool isAdmin;
    string userName = "";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        isAdmin = user.IsInRole("Administrator");
        userName = user.Identity?.Name ?? "";
        keys = await apiKeyService.GetKeysAsync();
    }

    async Task CreateKey()
    {
        // Checked again here so only administrators can change keys, whatever the UI shows
        if (!isAdmin)
            return;

        // The date picker gives a local date; the key works through the last moment of that day
        DateTime? expiresAt = NewKey.ExpiresOn?.Date.AddDays(1).AddTicks(-1).ToUniversalTime();
        var scopes = NewKey.Scopes.ToScopes();
        newKey = await apiKeyService.CreateKeyAsync(NewKey.Name.Trim(), expiresAt, scopes, userName);
        logger.LogWarning("{Actor} created API key {KeyName} (expires {ExpiresAt}) with permissions: {Scopes}",
            userName, NewKey.Name.Trim(), expiresAt?.ToString("u") ?? "never", ApiScopes.Describe(scopes));
        ShowMessage($"{NewKey.Name.Trim()} created!", "Success", ToastType.Success);
        NewKey = new();
        keys = await apiKeyService.GetKeysAsync();
    }

    async Task CopyKey()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", newKey);
            ShowMessage("Key copied to the clipboard.", "Copied", ToastType.Info);
        }
        catch (JSException)
        {
            ShowMessage("Couldn't copy automatically. Select the key and copy it.", "Copy failed", ToastType.Warning);
        }
    }

    async Task SetEnabled(ApiKey key, bool enabled)
    {
        if (!isAdmin)
            return;

        await apiKeyService.SetEnabledAsync(key.Id, enabled);
        logger.LogWarning("{Actor} {Action} API key {KeyName}", userName, enabled ? "enabled" : "disabled", key.Name);
        ShowMessage($"{key.Name} {(enabled ? "enabled" : "disabled")}!", "Success", ToastType.Success);
        keys = await apiKeyService.GetKeysAsync();
    }

    async Task EditScopes(ApiKey key)
    {
        if (!isAdmin)
            return;

        editingKey = key;
        editingScopes = ApiScopeSelection.FromScopes(key.Scopes);
        scopesError = null;
        await scopesModal.ShowAsync();
    }

    async Task SaveScopes()
    {
        if (!isAdmin || editingKey == null)
            return;

        if (editingScopes.IsEmpty)
        {
            scopesError = "Choose at least one area, or full access. To stop the key working, disable it instead.";
            return;
        }

        var before = ApiScopes.Describe(editingKey.Scopes);
        var scopes = editingScopes.ToScopes();
        await apiKeyService.SetScopesAsync(editingKey.Id, scopes);
        logger.LogWarning("{Actor} changed the permissions of API key {KeyName} from {Before} to {After}",
            userName, editingKey.Name, before, ApiScopes.Describe(scopes));
        ShowMessage($"{editingKey.Name} permissions saved!", "Success", ToastType.Success);
        await scopesModal.HideAsync();
        editingKey = null;
        keys = await apiKeyService.GetKeysAsync();
    }

    async Task DeleteKey(ApiKey key)
    {
        if (!isAdmin)
            return;

        var confirmation = await dialog.ShowAsync(
            title: $"Delete the {key.Name} API key?",
            message1: "Anything using this key will stop working. This can't be undone.",
            message2: "Do you want to proceed?");

        if (confirmation)
        {
            await apiKeyService.DeleteKeyAsync(key.Id);
            logger.LogWarning("{Actor} deleted API key {KeyName}", userName, key.Name);
            ShowMessage($"{key.Name} deleted!", "Success", ToastType.Success);
            keys = await apiKeyService.GetKeysAsync();
        }
    }

    static string Status(ApiKey key) =>
        !key.Enabled ? "Disabled" : key.ExpiresAt <= DateTime.UtcNow ? "Expired" : "Active";

    static string StatusClass(ApiKey key) => Status(key) switch
    {
        "Active" => "bg-success",
        "Expired" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    List<ToastMessage> messages = new List<ToastMessage>();

    private void ShowMessage(string message, string title, ToastType toastType) => messages.Add(CreateToastMessage(message, title, toastType));

    private ToastMessage CreateToastMessage(string message, string title, ToastType toastType)
    => new ToastMessage
    {
        Title = title,
        Type = toastType,
        HelpText = $"{DateTime.Now}",
        Message = message,
    };

    public class NewKeyModel : IValidatableObject
    {
        [Required]
        [StringLength(100)]
        public string Name { get; set; } = "";

        public DateTime? ExpiresOn { get; set; }

        public ApiScopeSelection Scopes { get; set; } = new();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (ExpiresOn.HasValue && ExpiresOn.Value.Date < DateTime.Today)
                yield return new ValidationResult("The expiry date can't be in the past.", [nameof(ExpiresOn)]);
            if (Scopes.IsEmpty)
                yield return new ValidationResult("Choose at least one area, or full access.", [nameof(Scopes)]);
        }
    }
}
