@page "/roles"
@using IIGO.Services
@using Microsoft.AspNetCore.Identity
@inject NavigationManager _nav
@inject RoleManager<IdentityRole> _roleManager
@inject ILogger<Roles> logger
@attribute [Authorize(Policy = Feature.ViewRoles)]
@rendermode InteractiveServer

<PageTitle>Roles</PageTitle>

<PageHeader Title="Roles" />

<ConfirmDialog @ref="dialog" />

<AuthorizeView Roles="Administrator">
    <Authorized>
        <div class="input-group mb-3 mw-input">
            <input class="form-control" @bind="newRoleName" placeholder="New role name" />
            <button class="btn btn-primary" @onclick="CreateRole"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create Role</button>
        </div>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-start gap-2">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <div>@errorMessage</div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@if (roles == null)
{
    <LoadingState />
}
else
{
    <SectionCard Flush="true">
        <div class="table-responsive">
            <table class="table table-hover align-middle iigo-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in roles)
                    {
                        <tr>
                            <td class="fw-semibold">@role.Name</td>
                            <td class="text-end">
                                <div class="row-actions">
                                    @if (role.Name != "Administrator")
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _nav.NavigateTo($"/roles/{role.Id}"))"><i class="bi bi-sliders me-1" aria-hidden="true"></i>Permissions</button>
                                        <AuthorizeView Roles="Administrator">
                                            <Authorized>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteRole(role.Id))"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete</button>
                                            </Authorized>
                                        </AuthorizeView>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary"><i class="bi bi-lock me-1" aria-hidden="true"></i>Built-in (all permissions)</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </SectionCard>
}

@code {
    private ConfirmDialog dialog = default!;
    List<IdentityRole>? roles;
    string newRoleName = "";
    string? errorMessage;
    bool isAdmin;
    string actor = "";

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        isAdmin = user.IsInRole("Administrator");
        actor = user.Identity?.Name ?? "";
        roles = _roleManager.Roles.ToList();
    }

    // Checked again in the handlers so only administrators can change roles, whatever the UI shows
    async Task CreateRole()
    {
        if (!isAdmin)
            return;

        errorMessage = null;
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            errorMessage = "Role name cannot be empty.";
            return;
        }

        var result = await _roleManager.CreateAsync(new IdentityRole { Name = newRoleName.Trim() });
        if (result.Succeeded)
        {
            logger.LogWarning("{Actor} created role {RoleName}", actor, newRoleName.Trim());
            newRoleName = "";
            roles = _roleManager.Roles.ToList();
        }
        else
        {
            errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
        }
    }

    async Task DeleteRole(string id)
    {
        if (!isAdmin)
            return;

        bool confirmed = await dialog.ShowAsync(
            title: "Are you sure you want to delete this role?",
            message1: "Users lose the permissions this role grants.",
            message2: "Do you want to proceed?");
        if (confirmed)
        {
            var role = await _roleManager.FindByIdAsync(id);
            if (role != null && role.Name != "Administrator")
            {
                var result = await _roleManager.DeleteAsync(role);
                if (result.Succeeded)
                    logger.LogWarning("{Actor} deleted role {RoleName}", actor, role.Name);
                else
                    errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                roles = _roleManager.Roles.ToList();
            }
        }
    }
}
