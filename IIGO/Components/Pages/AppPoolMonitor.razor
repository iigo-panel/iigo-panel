@page "/apppoolmonitor"
@using IIGO.Data
@using IIGO.Services
@inject AppPoolMonitorService monitorService
@inject MonitorHistoryService historyService
@attribute [Authorize(Policy = Feature.ViewAppPools)]
@rendermode InteractiveServer

<PageTitle>Application Pool Monitor</PageTitle>

<PageHeader Title="Application Pool Monitor" Subtitle="Stopped application pools are started automatically. A notification is sent when a pool keeps stopping." ParentText="App Pools" ParentHref="/apppools" />

<MonitorStatus Monitor="monitorService" />

<div class="row g-3">
    <div class="col-lg-7">
        <div class="d-flex flex-column gap-3">
            <SectionCard Title="@($"Restarts in the last {HistoryDays} days")" Flush="true">
                @if (events == null)
                {
                    <LoadingState />
                }
                else if (events.Count == 0)
                {
                    <EmptyState Icon="bi-check-circle" Title="No application pools were restarted." />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle iigo-table">
                            <thead>
                                <tr>
                                    <th>Application Pool</th>
                                    <th>Restarts</th>
                                    <th>Last Restart</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pool in events.GroupBy(x => x.AppPoolName).OrderByDescending(x => x.Count()))
                                {
                                    <tr>
                                        <td><a href="/apppools/@Uri.EscapeDataString(pool.Key)">@pool.Key</a></td>
                                        <td>@pool.Count()</td>
                                        <td>@pool.Max(x => x.AppPoolStartTime).ToLocalTime().ToString("g")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </SectionCard>

            @if (events != null && events.Count > 0)
            {
                <SectionCard Title="All events" Flush="true">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle iigo-table">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Application Pool</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in events)
                                {
                                    <tr>
                                        <td>@e.AppPoolStartTime.ToLocalTime().ToString("g")</td>
                                        <td>@e.AppPoolName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </SectionCard>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <MonitorSettings Settings="AppPoolMonitorService.Settings" NotificationFeature="@NotificationFeature.AppPoolMonitor" />
            </Authorized>
            <NotAuthorized>
                <MonitorSettings Settings="AppPoolMonitorService.Settings" NotificationFeature="@NotificationFeature.AppPoolMonitor" ReadOnly="true" />
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    const int HistoryDays = 30;
    List<AppPoolMonitoring>? events;

    protected override async Task OnInitializedAsync()
    {
        events = await historyService.GetAppPoolEventsAsync(HistoryDays);
    }
}
