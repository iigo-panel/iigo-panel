@page "/apppools/{name}/applications"
@using IIGO.Services
@inject IISService IISService
@attribute [Authorize(Policy = Feature.ViewAppPools)]
@rendermode InteractiveServer

<PageTitle>Applications - @Name</PageTitle>

<PageHeader Title="Applications" Subtitle="@($"Application pool {Name}")" ParentText="App Pools" ParentHref="/apppools" />

<div class="alert alert-info d-flex align-items-start gap-2">
    <i class="bi bi-funnel" aria-hidden="true"></i>
    <div>
        The applications have been filtered by the <strong>@Name</strong> application pool.
        <a href="/apppools">Remove filter</a>
    </div>
</div>

@if (applications == null)
{
    <LoadingState />
}
else if (applications.Count == 0)
{
    <SectionCard>
        <EmptyState Title="No applications use this pool." />
    </SectionCard>
}
else
{
    <SectionCard Flush="true">
        <div class="table-responsive">
            <table class="table table-hover align-middle iigo-table">
                <thead>
                    <tr>
                        <th>Virtual Path</th>
                        <th>Physical Path</th>
                        <th>Site</th>
                        <th>Application Pool</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in applications)
                    {
                        <tr>
                            <td>@app.VirtualPath</td>
                            <td><div class="cell-truncate cell-truncate-lg" title="@app.PhysicalPath">@app.PhysicalPath</div></td>
                            <td>@app.SiteName</td>
                            <td>@Name</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </SectionCard>
}

@code {
    [Parameter]
    public string Name { get; set; } = "";

    private List<(string SiteName, string VirtualPath, string PhysicalPath)>? applications;

    protected override void OnInitialized()
    {
        applications = IISService.GetApplicationsByPool(Name);
    }
}
