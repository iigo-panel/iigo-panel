@page "/tasks"
@using Microsoft.Win32.TaskScheduler
@using IIGO.Services
@inject IHttpContextAccessor httpContextAccessor
@attribute [Authorize(Policy = Feature.ViewScheduledTasks)]
@attribute [StreamRendering]
@rendermode InteractiveServer

<PageTitle>Scheduled Tasks</PageTitle>

<PageHeader Title="Scheduled Tasks" />

@if (tasks == null)
{
    <LoadingState />
}
else if (tasks.Count == 0)
{
    <SectionCard>
        <EmptyState Icon="bi-calendar-x" Title="No scheduled tasks in the root folder." />
    </SectionCard>
}
else
{
    <SectionCard Flush="true">
        <div class="table-scroll">
            <table class="table table-hover align-middle iigo-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Last Run Time</th>
                        <th>Next Run Time</th>
                        <th>State</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr>
                            <td>@task.Name</td>
                            <td class="text-nowrap tabular-nums">@task.LastRunTime.ToString("g")</td>
                            <td class="text-nowrap tabular-nums">@task.NextRunTime</td>
                            <td><StatusBadge Status="@task.State.ToString()" /></td>
                            <td><StatusBadge Status="@(task.IsActive ? "Active" : "Inactive")" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </SectionCard>
}

@code {
    List<Microsoft.Win32.TaskScheduler.Task>? tasks;
    protected override void OnInitialized()
    {
        tasks = TaskService.Instance.RootFolder.Tasks.ToList();
    }
}
