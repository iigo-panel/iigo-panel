@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using IIGO.Data

@inject SignInManager<ApplicationUser> SignInManager

@* Buttons for the external login providers plugins add. Shows nothing when there are none. *@
@if (externalLogins.Length > 0)
{
    <div class="d-flex align-items-center gap-2 my-3 text-body-secondary small">
        <hr class="flex-grow-1 my-0" /><span>or</span><hr class="flex-grow-1 my-0" />
    </div>
    <form action="Account/PerformExternalLogin" method="post" class="d-grid gap-2">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        @foreach (var provider in externalLogins)
        {
            <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name">
                Sign in with @provider.DisplayName
            </button>
        }
    </form>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync())
            .OrderBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }
}
