@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var statusMessageClass = DisplayMessage.StartsWith("Error") ? "danger" : "success";
    var statusMessageIcon = statusMessageClass == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";
    <div class="alert alert-@statusMessageClass d-flex align-items-start gap-2" role="alert">
        <i class="bi @statusMessageIcon" aria-hidden="true"></i>
        <div>@DisplayMessage</div>
    </div>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
