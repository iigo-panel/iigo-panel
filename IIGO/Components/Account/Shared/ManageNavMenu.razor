@using Microsoft.AspNetCore.Identity
@using IIGO.Data

@inject SignInManager<ApplicationUser> SignInManager

<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage" Match="NavLinkMatch.All"><i class="bi bi-person me-2" aria-hidden="true"></i>Profile</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/Email"><i class="bi bi-envelope me-2" aria-hidden="true"></i>Email</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/ChangePassword"><i class="bi bi-key me-2" aria-hidden="true"></i>Password</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/TwoFactorAuthentication"><i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Two-factor authentication</NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
