@using IIGO.Models
@using IIGO.Services
@using IIGO.Services.Interfaces
@inject ConfigurationService configService
@inject IEnumerable<IMessengerService> messengers
@inject SecretProtector secrets

<SectionCard Title="@Title" Subtitle="@Subtitle" Actions="@Actions">
        @HeaderContent
        @foreach (var setting in Settings)
        {
            <div class="mb-3">
                <label class="form-label" for="@setting.Name">@setting.Label</label>
                <div>
                    @switch (setting.Type)
                    {
                        case MonitorSettingType.Toggle:
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="@setting.Name" disabled="@ReadOnly"
                                       checked="@IsOn(setting.Name)"
                                       @onchange="@(e => values[setting.Name] = ((bool)e.Value!) ? "true" : "false")" />
                            </div>
                            break;
                        case MonitorSettingType.Number:
                            <input class="form-control" type="number" min="1" id="@setting.Name" disabled="@ReadOnly" @bind="values[setting.Name]" />
                            break;
                        case MonitorSettingType.NumberPair:
                            <div class="input-group" style="max-width:28rem">
                                @for (int i = 0; i < 2; i++)
                                {
                                    var part = i;
                                    var partLabel = setting.PartLabels?.ElementAtOrDefault(part);
                                    <input class="form-control" type="number" min="1" id="@(part == 0 ? setting.Name : $"{setting.Name}-{part}")" disabled="@ReadOnly"
                                           aria-label="@($"{setting.Label} {partLabel}")"
                                           value="@GetPart(setting.Name, part)" @onchange="@(e => SetPart(setting.Name, part, e.Value?.ToString()))" />
                                    @if (partLabel != null)
                                    {
                                        <span class="input-group-text">@partLabel</span>
                                    }
                                }
                            </div>
                            break;
                        case MonitorSettingType.Email:
                            <input class="form-control" type="email" id="@setting.Name" disabled="@ReadOnly" @bind="values[setting.Name]" />
                            break;
                        case MonitorSettingType.Secret:
                            <input class="form-control" type="password" autocomplete="new-password" id="@setting.Name" disabled="@ReadOnly" @bind="values[setting.Name]"
                                   placeholder="@(savedSecrets.Contains(setting.Name) ? "Saved. Type a new value to replace it." : "Not set")" />
                            break;
                        case MonitorSettingType.Choice:
                            <select class="form-select" id="@setting.Name" disabled="@ReadOnly" @bind="values[setting.Name]">
                                @foreach (var option in setting.Options ?? [])
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                            break;
                        default:
                            <input class="form-control" type="text" id="@setting.Name" disabled="@ReadOnly" @bind="values[setting.Name]" />
                            break;
                    }
                    @if (setting.Help != null)
                    {
                        <div class="form-text">@setting.Help</div>
                    }
                    @if (errors.TryGetValue(setting.Name, out var error))
                    {
                        <div class="text-danger">@error</div>
                    }
                </div>
            </div>
        }
        @if (NotificationFeature != null)
        {
            <div class="mb-3">
                <span class="form-label d-block">Send notifications through</span>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="notify-@EmailNotifications.ServiceIdentifier" disabled="@ReadOnly"
                           checked="@selectedServices.Contains(EmailNotifications.ServiceIdentifier)"
                           @onchange="@(e => ToggleService(EmailNotifications.ServiceIdentifier, (bool)e.Value!))" />
                    <label class="form-check-label" for="notify-@EmailNotifications.ServiceIdentifier">Email (@emailServiceName)</label>
                </div>
                @foreach (var messenger in messengers.Where(x => !x.IsEmail))
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="notify-@messenger.ServiceIdentifier" disabled="@ReadOnly"
                               checked="@selectedServices.Contains(messenger.ServiceIdentifier)"
                               @onchange="@(e => ToggleService(messenger.ServiceIdentifier, (bool)e.Value!))" />
                        <label class="form-check-label" for="notify-@messenger.ServiceIdentifier">@messenger.ServiceName</label>
                    </div>
                }
                <div class="form-text">Notifications go to every service ticked here. Leave them all unticked to turn notifications off.</div>
            </div>
        }
        @if (!ReadOnly)
        {
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-primary" @onclick="Save">Save Settings</button>
                @if (saveMessage != null)
                {
                    <span class="text-success">@saveMessage</span>
                }
            </div>
        }
        @ChildContent
</SectionCard>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MonitorSetting> Settings { get; set; } = [];

    [Parameter]
    public string Title { get; set; } = "Settings";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    // Shown above the settings, e.g. a service picker
    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    // Shown below the Save button, e.g. a test button
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // Raised after the settings are saved
    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    // One of the NotificationFeature constants; shows the notification service checkboxes when set
    [Parameter]
    public string? NotificationFeature { get; set; }

    Dictionary<string, string> values = new();
    Dictionary<string, string> errors = new();
    HashSet<string> selectedServices = new();
    // Secrets with a stored value. Their values are never loaded into the form.
    HashSet<string> savedSecrets = new();
    string? emailServiceName;
    string? saveMessage;

    protected override void OnInitialized()
    {
        var stored = configService.GetSettings(Settings.Select(x => x.Name));
        values = Settings.ToDictionary(x => x.Name, x => x.Type == MonitorSettingType.Secret ? "" : stored.GetValueOrDefault(x.Name, x.DefaultValue));
        savedSecrets = Settings
            .Where(x => x.Type == MonitorSettingType.Secret && !string.IsNullOrEmpty(stored.GetValueOrDefault(x.Name)))
            .Select(x => x.Name)
            .ToHashSet();

        if (NotificationFeature != null)
        {
            selectedServices = configService.GetNotificationServices(NotificationFeature);
            var emailService = configService.GetSetting(EmailNotifications.Setting, EmailNotifications.DefaultService);
            emailServiceName = messengers.FirstOrDefault(x => x.ServiceIdentifier == emailService)?.ServiceName ?? emailService;
        }
    }

    bool IsOn(string name) => bool.TryParse(values[name], out var on) && on;

    // NumberPair values stay stored as "a,b"; each box edits one side
    string GetPart(string name, int index) => values[name]?.Split(',').ElementAtOrDefault(index)?.Trim() ?? "";

    void SetPart(string name, int index, string? value)
    {
        var parts = new[] { GetPart(name, 0), GetPart(name, 1) };
        parts[index] = value?.Trim() ?? "";
        values[name] = string.Join(",", parts);
    }

    void ToggleService(string identifier, bool selected)
    {
        if (selected)
            selectedServices.Add(identifier);
        else
            selectedServices.Remove(identifier);
    }

    async Task Save()
    {
        saveMessage = null;
        errors = Settings
            .Select(x => (x.Name, Error: Validate(x, values[x.Name]?.Trim() ?? "")))
            .Where(x => x.Error != null)
            .ToDictionary(x => x.Name, x => x.Error!);

        // Email has no one to send to without recipients
        if (selectedServices.Contains(EmailNotifications.ServiceIdentifier))
        {
            foreach (var setting in Settings.Where(x => x.Type == MonitorSettingType.EmailList && string.IsNullOrWhiteSpace(values[x.Name])))
                errors.TryAdd(setting.Name, "Enter at least one address, or untick Email.");
        }

        if (errors.Count > 0)
            return;

        // A blank secret keeps the stored value; a new one is encrypted before it's stored
        var toSave = new Dictionary<string, string>();
        foreach (var setting in Settings)
        {
            var value = values[setting.Name]?.Trim() ?? "";
            if (setting.Type != MonitorSettingType.Secret)
                toSave[setting.Name] = value;
            else if (value.Length > 0)
                toSave[setting.Name] = secrets.Protect(value);
        }

        configService.SaveSettings(toSave);
        if (NotificationFeature != null)
            configService.SetNotificationServices(NotificationFeature, selectedServices);

        foreach (var setting in Settings.Where(x => x.Type == MonitorSettingType.Secret && values[x.Name]?.Trim().Length > 0))
        {
            savedSecrets.Add(setting.Name);
            values[setting.Name] = "";
        }

        saveMessage = "Saved!";
        await OnSaved.InvokeAsync();
    }

    static string? Validate(MonitorSetting setting, string value)
    {
        // ConfigSetting.SettingValue is varchar(300)
        if (value.Length > 300)
            return "Must be 300 characters or fewer.";

        switch (setting.Type)
        {
            case MonitorSettingType.Number:
                return int.TryParse(value, out var n) && n > 0 ? null : "Enter a whole number greater than 0.";
            case MonitorSettingType.NumberPair:
                var parts = value.Split(',', StringSplitOptions.TrimEntries);
                return parts.Length == 2 && parts.All(p => int.TryParse(p, out var x) && x > 0) ? null : "Enter a whole number greater than 0 in both boxes.";
            case MonitorSettingType.Email:
                return value.Length == 0 || System.Net.Mail.MailAddress.TryCreate(value, out _) ? null : "Enter a valid email address.";
            case MonitorSettingType.Choice:
                return setting.Options?.Contains(value) == true ? null : "Choose one of the options.";
            case MonitorSettingType.EmailList:
                var addresses = value.Split([',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                var invalid = addresses.Where(a => !System.Net.Mail.MailAddress.TryCreate(a, out _)).ToList();
                return invalid.Count == 0 ? null : $"Not a valid email address: {string.Join(", ", invalid)}";
            default:
                return null;
        }
    }
}
