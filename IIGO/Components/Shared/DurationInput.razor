@* A length of time as a number and a unit (minutes, hours or days), bound to a TimeSpan *@

<div class="input-group">
    <div class="form-floating">
        <input type="number" min="0" class="form-control" id="@Id" placeholder="@Label" value="@amount" @onchange="AmountChanged" />
        <label for="@Id">@Label</label>
    </div>
    <select class="form-select flex-grow-0 w-auto" aria-label="@($"{Label} unit")" value="@unit" @onchange="UnitChanged">
        @foreach (var option in Enum.GetValues<Unit>())
        {
            <option value="@option">@option</option>
        }
    </select>
</div>

@code {
    [Parameter]
    public TimeSpan Value { get; set; }

    [Parameter]
    public EventCallback<TimeSpan> ValueChanged { get; set; }

    [Parameter, EditorRequired]
    public string Id { get; set; } = "";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    enum Unit { Minutes, Hours, Days }

    long amount;
    Unit unit = Unit.Minutes;
    TimeSpan? shown;

    protected override void OnParametersSet()
    {
        if (shown == Value)
            return;

        // Largest unit that shows the value as a whole number. The value is only rewritten when it's edited,
        // so a value with seconds isn't rounded by opening the form
        unit = Value == TimeSpan.Zero ? unit
            : Value.Ticks % TimeSpan.TicksPerDay == 0 ? Unit.Days
            : Value.Ticks % TimeSpan.TicksPerHour == 0 ? Unit.Hours
            : Unit.Minutes;
        amount = (long)Math.Round(Value.Ticks / (double)TicksPer(unit));
        shown = Value;
    }

    static long TicksPer(Unit unit) => unit switch
    {
        Unit.Days => TimeSpan.TicksPerDay,
        Unit.Hours => TimeSpan.TicksPerHour,
        _ => TimeSpan.TicksPerMinute
    };

    async Task AmountChanged(ChangeEventArgs e)
    {
        amount = long.TryParse(e.Value?.ToString(), out var parsed) ? Math.Max(0, Math.Min(parsed, 99999)) : 0;
        await Raise();
    }

    async Task UnitChanged(ChangeEventArgs e)
    {
        unit = Enum.TryParse<Unit>(e.Value?.ToString(), out var parsed) ? parsed : Unit.Minutes;
        await Raise();
    }

    async Task Raise()
    {
        shown = TimeSpan.FromTicks(amount * TicksPer(unit));
        await ValueChanged.InvokeAsync(shown.Value);
    }
}
